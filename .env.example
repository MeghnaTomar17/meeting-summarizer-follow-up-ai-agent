# MannerAI Meetings Platform — environment template
# Copy to .env and fill values. Do not commit .env.
#
# Single repository-level .env for local development (all services).

# Application
APP_NAME=mannerai-meetings
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mannerai_meetings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Gateway
JWT_SECRET=dev-only-jwt-secret-not-for-production-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MEETING_SERVICE_URL=http://localhost:8001
AI_SERVICE_URL=http://localhost:8002
SEARCH_SERVICE_URL=http://localhost:8003

# AI
# OpenAI is the first configured provider. Leave its key empty until available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Dedicated RS256 job authorization keys; never reuse JWT/internal-principal keys.
# Supply matching RSA-2048+ PEM material in deployment secrets (escaped newlines accepted).
BACKGROUND_JOB_SIGNING_PRIVATE_KEY=
BACKGROUND_JOB_VERIFICATION_PUBLIC_KEY=
BACKGROUND_JOB_ISSUER=ai-service
BACKGROUND_JOB_AUDIENCE=mannerai-worker
BACKGROUND_JOB_AUTHORIZATION_EXPIRE_SECONDS=120
BACKGROUND_JOB_AUTHORIZATION_MAX_AGE_SECONDS=120

# Search
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Worker-service local development defaults; these values do not start Redis.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_TASK_ACKS_LATE=false
CELERY_TASK_REJECT_ON_WORKER_LOST=false
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=1
