# MannerAI Meetings Platform — environment template
# Copy to .env and fill values. Do not commit .env.
#
# Single repository-level .env for local development (all services).

# Application
APP_NAME=mannerai-meetings
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mannerai_meetings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Gateway
JWT_SECRET=dev-only-jwt-secret-not-for-production-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MEETING_SERVICE_URL=http://localhost:8001
AI_SERVICE_URL=http://localhost:8002
SEARCH_SERVICE_URL=http://localhost:8003

# AI
# OpenAI is the first configured provider. Leave its key empty until available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Search
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Worker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
