# MannerAI Meetings Platform — environment template
# Copy to .env and fill values. Do not commit .env.
#
# Local venv development: use localhost URLs below (default).
# Docker Compose: service URLs are overridden in docker-compose.yml.

# Application
APP_NAME=mannerai-meetings
APP_ENV=development
LOG_LEVEL=INFO

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Services (local venv — use localhost)
MEETING_SERVICE_URL=http://localhost:8001
MEETING_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8002
AI_SERVICE_PORT=8002
SEARCH_SERVICE_URL=http://localhost:8003
SEARCH_SERVICE_PORT=8003
WORKER_SERVICE_URL=http://localhost:8004
WORKER_SERVICE_PORT=8004

# Reverse proxy (Docker only)
NGINX_HTTP_PORT=80

# PostgreSQL (local venv — start DB via Docker or local install)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mannerai_meetings
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mannerai_meetings
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# JWT / Auth
JWT_SECRET=change-me-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Celery (Phase 7)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage (Phase 11+)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
