# MannerAI Meetings Platform — environment template
# Copy to .env and fill values. Do not commit .env.

# Application
APP_NAME=mannerai-meetings
APP_ENV=development
LOG_LEVEL=INFO

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Services (internal)
MEETING_SERVICE_URL=http://meeting-service:8001
AI_SERVICE_URL=http://ai-service:8002
SEARCH_SERVICE_URL=http://search-service:8003
WORKER_SERVICE_URL=http://worker-service:8004

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/mannerai_meetings
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# JWT / Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Object storage (future)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
