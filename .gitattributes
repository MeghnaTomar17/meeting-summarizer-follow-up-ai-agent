# Normalize line endings for cross-platform clones (Windows ↔ macOS ↔ Linux)
* text=auto

*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.Dockerfile text eol=lf
*.conf text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
